source env/desktop-app/config
source env/distro.info
source env/function.sh
export STEP_BUILDNAME=desktop-app
export STEP_PACKAGENAME=glibmm
export PACKAGE_VERSION=2.88.1
export RESOURCEDIR=${NEW_TARGET_SYSDIR}/files/desktop-app/glibmm/2.88.1/
rm -rf ${BUILD_DIRECTORY}/glibmm-2.88.1
tar xvf ${DOWNLOADDIR}/glibmm-2.88.1.tar.xz -C ${BUILD_DIRECTORY} 
pushd ${BUILD_DIRECTORY}/glibmm-2.88.1
	patch -Np1 -i ${SYSDIR}/files/desktop-app/glibmm/2.88.1/patches/glibmm2.68-2.88.1-glib_2.89.2-dont-derive-gtkmm-gxxx-types.patch 
	 
	mkdir cross-build
	pushd cross-build
		 meson ${MESON_CONFIG}  \
                      ..
		sed -i "s@gi-docgen \(index\|generate\|gen-index\|gen-deps\|search\|check\|serve\) @& --add-include-path ${SYSROOT_DIR}/usr/share/gir-1.0/ @g" build.ninja
		eval ${NINJA_AND_INSTALL}
	popd
	rm -f ${SYSROOT_DIR}/usr/lib64/*.la
popd 
rm -rf ${BUILD_DIRECTORY}/glibmm-2.88.1
