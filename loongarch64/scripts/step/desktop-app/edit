source env/desktop-app/config
source env/distro.info
source env/function.sh
export STEP_BUILDNAME=desktop-app
export STEP_PACKAGENAME=edit
export PACKAGE_VERSION=2.0.0
export RESOURCEDIR=${NEW_TARGET_SYSDIR}/files/desktop-app/edit/2.0.0/
rm -rf ${BUILD_DIRECTORY}/edit-2.0.0
tar xvf ${DOWNLOADDIR}/edit-2.0.0.tar.gz -C ${BUILD_DIRECTORY} 
pushd ${BUILD_DIRECTORY}/edit-2.0.0
    patch -Np1 -i ${SYSDIR}/files/desktop-app/edit/2.0.0/patches/737450cef9ee40030221d1ddc4e91a5e67173306.diff 
	 
    RUSTFLAGS="$RUSTFLAGS -C linker=${CROSS_TARGET}-gcc -Ccode-model=medium --sysroot=${CROSSTOOLS_DIR}" \
    cargo build --release --target ${CROSS_TARGET}
    install -Dm755 target/${CROSS_TARGET}/release/edit ${SYSROOT_DIR}/usr/bin/
popd 
rm -rf ${BUILD_DIRECTORY}/edit-2.0.0
