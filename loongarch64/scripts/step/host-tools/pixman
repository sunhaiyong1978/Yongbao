source env/host-tools/config
source env/distro.info
source env/function.sh
export STEP_BUILDNAME=host-tools
export STEP_PACKAGENAME=pixman
export PACKAGE_VERSION=0.46.4
export RESOURCEDIR=${NEW_TARGET_SYSDIR}/files/host-tools/pixman/0.46.4/
rm -rf ${BUILD_DIRECTORY}/pixman-0.46.4
tar xvf ${DOWNLOADDIR}/pixman-0.46.4.tar.xz -C ${BUILD_DIRECTORY} 
pushd ${BUILD_DIRECTORY}/pixman-0.46.4
    
    mkdir -p native-build
    pushd native-build
        meson --prefix=${PREFIX} --libdir=${PREFIX}/lib${LIB_SUFF}  \
              --buildtype=release ..
        ninja
        ninja install
    popd
popd 
rm -rf ${BUILD_DIRECTORY}/pixman-0.46.4
