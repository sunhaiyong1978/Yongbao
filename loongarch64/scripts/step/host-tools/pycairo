source env/host-tools/config
source env/distro.info
source env/function.sh
export STEP_BUILDNAME=host-tools
export STEP_PACKAGENAME=pycairo
export PACKAGE_VERSION=1.29.0
export RESOURCEDIR=${NEW_TARGET_SYSDIR}/files/host-tools/pycairo/1.29.0/
rm -rf ${BUILD_DIRECTORY}/pycairo-1.29.0
tar xvf ${DOWNLOADDIR}/pycairo-1.29.0.tar.gz -C ${BUILD_DIRECTORY} 
pushd ${BUILD_DIRECTORY}/pycairo-1.29.0
    
    mkdir -p native-build
    pushd native-build
        meson --prefix=${PREFIX} --libdir=${PREFIX}/lib${LIB_SUFF}  \
              --buildtype=release ..
        ninja
        ninja install
    popd
popd 
rm -rf ${BUILD_DIRECTORY}/pycairo-1.29.0
