source env/host-tools/config
source env/distro.info
source env/function.sh
export STEP_BUILDNAME=host-tools
export STEP_PACKAGENAME=pipewire
export PACKAGE_VERSION=1.6.6
export RESOURCEDIR=${NEW_TARGET_SYSDIR}/files/host-tools/pipewire/1.6.6/
rm -rf ${BUILD_DIRECTORY}/pipewire-1.6.6
tar xvf ${DOWNLOADDIR}/pipewire-1.6.6.tar.gz -C ${BUILD_DIRECTORY} 
pushd ${BUILD_DIRECTORY}/pipewire-1.6.6
    
    mkdir -p native-build
    pushd native-build
        meson --prefix=${PREFIX} --libdir=${PREFIX}/lib${LIB_SUFF} -Dsession-managers="[]" \
              --buildtype=release ..
        ninja
        ninja install
    popd
popd 
rm -rf ${BUILD_DIRECTORY}/pipewire-1.6.6
