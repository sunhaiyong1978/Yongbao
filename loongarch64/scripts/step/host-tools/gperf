export PACKAGE_VERSION=3.3
export RESOURCEDIR=${NEW_TARGET_SYSDIR}/files/host-tools/gperf/3.3/
rm -rf ${BUILD_DIRECTORY}/gperf-3.3
tar xvf ${DOWNLOADDIR}/gperf-3.3.tar.gz -C ${BUILD_DIRECTORY} 
pushd ${BUILD_DIRECTORY}/gperf-3.3
	
        for config_i in $(find -name "config.sub")
