source env/host-tools/config
source env/distro.info
source env/function.sh
export STEP_BUILDNAME=host-tools
export STEP_PACKAGENAME=cairo
export PACKAGE_VERSION=1.18.4
export RESOURCEDIR=${NEW_TARGET_SYSDIR}/files/host-tools/cairo/1.18.4/
rm -rf ${BUILD_DIRECTORY}/cairo-1.18.4
tar xvf ${DOWNLOADDIR}/cairo-1.18.4.tar.xz -C ${BUILD_DIRECTORY} 
pushd ${BUILD_DIRECTORY}/cairo-1.18.4
    
    mkdir -p native-build
    pushd native-build
        meson --prefix=${PREFIX} --libdir=${PREFIX}/lib${LIB_SUFF}  \
              --buildtype=release ..
        ninja
        ninja install
    popd
popd 
rm -rf ${BUILD_DIRECTORY}/cairo-1.18.4
