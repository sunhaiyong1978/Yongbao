source env/host-tools/config
source env/distro.info
source env/function.sh
export STEP_BUILDNAME=host-tools
export STEP_PACKAGENAME=pygobject
export PACKAGE_VERSION=3.56.3
export RESOURCEDIR=${NEW_TARGET_SYSDIR}/files/host-tools/pygobject/3.56.3/
rm -rf ${BUILD_DIRECTORY}/pygobject-3.56.3
tar xvf ${DOWNLOADDIR}/pygobject-3.56.3.tar.gz -C ${BUILD_DIRECTORY} 
pushd ${BUILD_DIRECTORY}/pygobject-3.56.3
    
    mkdir -p native-build
    pushd native-build
        meson --prefix=${PREFIX} --libdir=${PREFIX}/lib${LIB_SUFF} -Dtests=false \
              --buildtype=release ..
        ninja
        ninja install
    popd
popd 
rm -rf ${BUILD_DIRECTORY}/pygobject-3.56.3
