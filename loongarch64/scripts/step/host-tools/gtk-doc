source env/host-tools/config
source env/distro.info
source env/function.sh
export STEP_BUILDNAME=host-tools
export STEP_PACKAGENAME=gtk-doc
export PACKAGE_VERSION=1.36.1
export RESOURCEDIR=${NEW_TARGET_SYSDIR}/files/host-tools/gtk-doc/1.36.1/
rm -rf ${BUILD_DIRECTORY}/gtk-doc-1.36.1
tar xvf ${DOWNLOADDIR}/gtk-doc-1.36.1.tar.xz -C ${BUILD_DIRECTORY} 
pushd ${BUILD_DIRECTORY}/gtk-doc-1.36.1
    
    mkdir -p native-build
    pushd native-build
        meson --prefix=${PREFIX} --libdir=${PREFIX}/lib${LIB_SUFF}  \
              --buildtype=release ..
        ninja
        ninja install
    popd
popd 
rm -rf ${BUILD_DIRECTORY}/gtk-doc-1.36.1
