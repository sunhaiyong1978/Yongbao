source env/mingw_sysroot/config
source env/distro.info
source env/function.sh
source env/mingw_sysroot/custom
export STEP_BUILDNAME=mingw_sysroot
export STEP_PACKAGENAME=mingw-gdk-pixbuf
export PACKAGE_VERSION=2.44.6
export RESOURCEDIR=${NEW_TARGET_SYSDIR}/files/mingw_sysroot/mingw-gdk-pixbuf/2.44.6/
rm -rf ${BUILD_DIRECTORY}/gdk-pixbuf-2.44.6
tar xvf ${DOWNLOADDIR}/gdk-pixbuf-2.44.6.tar.xz -C ${BUILD_DIRECTORY} 
pushd ${BUILD_DIRECTORY}/gdk-pixbuf-2.44.6
    mkdir cross-build
    pushd cross-build
        meson ${MESON_CONFIG} --default-library=both --wrap-mode=nofallback -Dintrospection=disabled -Dman=false -Djpeg=disabled ..
	eval ${NINJA_AND_INSTALL}
    popd
popd 
rm -rf ${BUILD_DIRECTORY}/gdk-pixbuf-2.44.6
