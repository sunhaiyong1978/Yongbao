source env/base_support/config
source env/distro.info
source env/function.sh
export STEP_BUILDNAME=base_support
export STEP_PACKAGENAME=alsa-firmware
export PACKAGE_VERSION=1.2.4
export RESOURCEDIR=${NEW_TARGET_SYSDIR}/files/base_support/alsa-firmware/1.2.4/
rm -rf ${BUILD_DIRECTORY}/alsa-firmware-1.2.4
tar xvf ${DOWNLOADDIR}/alsa-firmware-1.2.4.tar.bz2 -C ${BUILD_DIRECTORY} 
pushd ${BUILD_DIRECTORY}/alsa-firmware-1.2.4
	
	for config_i in $(find -name "config.sub")
	do
		cp -a -f $(automake --print-libdir)/config.{sub,guess} $(dirname ${config_i})/
	done
	if [ ! -f configure ]; then
		autoreconf -ifv
	fi
	 ./configure ${COMMON_CONFIG}  --enable-malloc0returnsnull
	eval ${MAKE_AND_INSTALL}
popd 
rm -rf ${BUILD_DIRECTORY}/alsa-firmware-1.2.4
