source env/base_support/config
source env/distro.info
source env/function.sh
export STEP_BUILDNAME=base_support
export STEP_PACKAGENAME=xkbutils
export PACKAGE_VERSION=1.0.6
export RESOURCEDIR=${NEW_TARGET_SYSDIR}/files/base_support/xkbutils/1.0.6/
rm -rf ${BUILD_DIRECTORY}/xkbutils-1.0.6
tar xvf ${DOWNLOADDIR}/xkbutils-1.0.6.tar.xz -C ${BUILD_DIRECTORY} 
pushd ${BUILD_DIRECTORY}/xkbutils-1.0.6
	
	for config_i in $(find -name "config.sub")
	do
		cp -a -f $(automake --print-libdir)/config.{sub,guess} $(dirname ${config_i})/
	done
	if [ ! -f configure ]; then
		autoreconf -ifv
	fi
	CFLAGS="${CFLAGS} -Wno-incompatible-pointer-types" ./configure ${COMMON_CONFIG}  --enable-malloc0returnsnull
	eval ${MAKE_AND_INSTALL}
popd 
rm -rf ${BUILD_DIRECTORY}/xkbutils-1.0.6
