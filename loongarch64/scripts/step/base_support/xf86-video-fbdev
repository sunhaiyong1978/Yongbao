source env/base_support/config
source env/distro.info
source env/function.sh
export STEP_BUILDNAME=base_support
export STEP_PACKAGENAME=xf86-video-fbdev
export PACKAGE_VERSION=0.5.1
export RESOURCEDIR=${NEW_TARGET_SYSDIR}/files/base_support/xf86-video-fbdev/0.5.1/
rm -rf ${BUILD_DIRECTORY}/xf86-video-fbdev-0.5.1
tar xvf ${DOWNLOADDIR}/xf86-video-fbdev-0.5.1.tar.xz -C ${BUILD_DIRECTORY} 
pushd ${BUILD_DIRECTORY}/xf86-video-fbdev-0.5.1
	
	for config_i in $(find -name "config.sub")
	do
		cp -a -f $(automake --print-libdir)/config.{sub,guess} $(dirname ${config_i})/
	done
	if [ ! -f configure ]; then
		autoreconf -ifv
	fi
	 ./configure ${COMMON_CONFIG}  --enable-malloc0returnsnull
	eval ${MAKE_AND_INSTALL}
popd 
rm -rf ${BUILD_DIRECTORY}/xf86-video-fbdev-0.5.1
