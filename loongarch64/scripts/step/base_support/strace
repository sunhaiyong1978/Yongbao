source env/base_support/config
source env/distro.info
source env/function.sh
export STEP_BUILDNAME=base_support
export STEP_PACKAGENAME=strace
export PACKAGE_VERSION=7.0
export RESOURCEDIR=${NEW_TARGET_SYSDIR}/files/base_support/strace/7.0/
rm -rf ${BUILD_DIRECTORY}/strace-7.0
tar xvf ${DOWNLOADDIR}/strace-7.0.tar.xz -C ${BUILD_DIRECTORY} 
pushd ${BUILD_DIRECTORY}/strace-7.0
	
	for config_i in $(find -name "config.sub")
	do
		cp -a -f $(automake --print-libdir)/config.{sub,guess} $(dirname ${config_i})/
	done
	if [ ! -f configure ]; then
		autoreconf -ifv
	fi
	 ./configure ${COMMON_CONFIG} CFLAGS="${CFLAGS} -Wno-error=calloc-transposed-args -Wno-error=sign-compare" --enable-malloc0returnsnull
	eval ${MAKE_AND_INSTALL}
popd 
rm -rf ${BUILD_DIRECTORY}/strace-7.0
