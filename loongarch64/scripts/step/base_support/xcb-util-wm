source env/base_support/config
source env/distro.info
source env/function.sh
export STEP_BUILDNAME=base_support
export STEP_PACKAGENAME=xcb-util-wm
export PACKAGE_VERSION=0.4.2
export RESOURCEDIR=${NEW_TARGET_SYSDIR}/files/base_support/xcb-util-wm/0.4.2/
rm -rf ${BUILD_DIRECTORY}/xcb-util-wm-0.4.2
tar xvf ${DOWNLOADDIR}/xcb-util-wm-0.4.2.tar.xz -C ${BUILD_DIRECTORY} 
pushd ${BUILD_DIRECTORY}/xcb-util-wm-0.4.2
	
	for config_i in $(find -name "config.sub")
	do
		cp -a -f $(automake --print-libdir)/config.{sub,guess} $(dirname ${config_i})/
	done
	if [ ! -f configure ]; then
		autoreconf -ifv
	fi
	 ./configure ${COMMON_CONFIG}  --enable-malloc0returnsnull
	eval ${MAKE_AND_INSTALL}
popd 
rm -rf ${BUILD_DIRECTORY}/xcb-util-wm-0.4.2
