source env/base_support/config
source env/distro.info
source env/function.sh
export STEP_BUILDNAME=base_support
export STEP_PACKAGENAME=bpf
export PACKAGE_VERSION=6.18.8
export RESOURCEDIR=${NEW_TARGET_SYSDIR}/files/base_support/bpf/6.18.8/
rm -rf ${BUILD_DIRECTORY}/linux-6.18.8
tar xvf ${DOWNLOADDIR}/linux-6.18.8.tar.xz -C ${BUILD_DIRECTORY} 
pushd ${BUILD_DIRECTORY}/linux-6.18.8
	patch -Np1 -i ${SYSDIR}/files/base_support/bpf/6.18.8/patches/0001-libbpf-fix-build-error-for-glibc-2.43.patch 
	patch -Np1 -i ${SYSDIR}/files/base_support/bpf/6.18.8/patches/0001-linux-kernel-tools-perf-fix-build-error-for-glibc-2..patch 
	 
	pushd tools/bpf
		unset CFLAGS
		make -j${JOBS} HOSTCC="gcc" LDFLAGS="" ARCH=${ARCH_FAMILY} CROSS_COMPILE=${CROSS_TARGET}- bpftool
		cp -a bpftool/bpftool ${SYSROOT_DIR}/usr/bin/
	popd
popd 
rm -rf ${BUILD_DIRECTORY}/linux-6.18.8
