source env/base_support/config
source env/distro.info
source env/function.sh
export STEP_BUILDNAME=base_support
export STEP_PACKAGENAME=x264
export PACKAGE_VERSION=0.165.r3222
export RESOURCEDIR=${NEW_TARGET_SYSDIR}/files/base_support/x264/0.165.r3222/
rm -rf ${BUILD_DIRECTORY}/x264-0.165.r3222
tar xvf ${DOWNLOADDIR}/x264-0.165.r3222.tar.gz -C ${BUILD_DIRECTORY} 
pushd ${BUILD_DIRECTORY}/x264-0.165.r3222
	
	for config_i in $(find -name "config.sub")
	do
		cp -a -f $(automake --print-libdir)/config.{sub,guess} $(dirname ${config_i})/
	done
	if [ ! -f configure ]; then
		autoreconf -ifv
	fi
	 ./configure ${COMMON_CONFIG} --cross-prefix=${CROSS_TARGET}- --sysroot=${SYSROOT_DIR} --enable-shared --bashcompletionsdir=/usr/share/bash-completion/completions --enable-malloc0returnsnull
	eval ${MAKE_AND_INSTALL}
popd 
