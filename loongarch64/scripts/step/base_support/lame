source env/base_support/config
source env/distro.info
source env/function.sh
export STEP_BUILDNAME=base_support
export STEP_PACKAGENAME=lame
export PACKAGE_VERSION=4.0
export RESOURCEDIR=${NEW_TARGET_SYSDIR}/files/base_support/lame/4.0/
rm -rf ${BUILD_DIRECTORY}/lame-4.0
tar xvf ${DOWNLOADDIR}/lame-4.0.tar.gz -C ${BUILD_DIRECTORY} 
pushd ${BUILD_DIRECTORY}/lame-4.0
	
	for config_i in $(find -name "config.sub")
	do
		cp -a -f $(automake --print-libdir)/config.{sub,guess} $(dirname ${config_i})/
	done
	if [ ! -f configure ]; then
		autoreconf -ifv
	fi
	CFLAGS="${CFLAGS} -Wno-implicit-function-declaration -Wno-incompatible-pointer-types" ./configure ${COMMON_CONFIG}  --enable-mp3rtp --enable-malloc0returnsnull
	eval ${MAKE_AND_INSTALL}
popd 
rm -rf ${BUILD_DIRECTORY}/lame-4.0
