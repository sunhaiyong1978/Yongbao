source env/base_support/config
source env/distro.info
source env/function.sh
export STEP_BUILDNAME=base_support
export STEP_PACKAGENAME=libevdev
export PACKAGE_VERSION=1.13.6
export RESOURCEDIR=${NEW_TARGET_SYSDIR}/files/base_support/libevdev/1.13.6/
rm -rf ${BUILD_DIRECTORY}/libevdev-1.13.6
tar xvf ${DOWNLOADDIR}/libevdev-1.13.6.tar.xz -C ${BUILD_DIRECTORY} 
pushd ${BUILD_DIRECTORY}/libevdev-1.13.6
	
	for config_i in $(find -name "config.sub")
	do
		cp -a -f $(automake --print-libdir)/config.{sub,guess} $(dirname ${config_i})/
	done
	if [ ! -f configure ]; then
		autoreconf -ifv
	fi
	PYTHON=python3  ./configure ${COMMON_CONFIG}  --enable-malloc0returnsnull
	eval ${MAKE_AND_INSTALL}
popd 
rm -rf ${BUILD_DIRECTORY}/libevdev-1.13.6
