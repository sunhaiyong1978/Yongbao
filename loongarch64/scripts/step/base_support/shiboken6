source env/base_support/config
source env/distro.info
source env/function.sh
export STEP_BUILDNAME=base_support
export STEP_PACKAGENAME=shiboken6
export PACKAGE_VERSION=6.11.0
export RESOURCEDIR=${NEW_TARGET_SYSDIR}/files/base_support/shiboken6/6.11.0/
rm -rf ${BUILD_DIRECTORY}/pyside-setup-everywhere-src-6.11.0
tar xvf ${DOWNLOADDIR}/pyside-setup-everywhere-src-6.11.0.tar.xz -C ${BUILD_DIRECTORY} 
pushd ${BUILD_DIRECTORY}/pyside-setup-everywhere-src-6.11.0
        patch -Np1 -i ${SYSDIR}/files/base_support/shiboken6/6.11.0/patches/0001-Always-link-to-python-libraries.patch 
	patch -Np1 -i ${SYSDIR}/files/base_support/shiboken6/6.11.0/patches/0001-Fix-installation.patch 
	patch -Np1 -i ${SYSDIR}/files/base_support/shiboken6/6.11.0/patches/0001-Revert-Modify-headers-installation-for-CMake-builds.patch 
	 
	pushd sources/shiboken6
        mkdir cross-build
        pushd cross-build
                CC="${CROSS_TARGET}-gcc" CXX="${CROSS_TARGET}-g++" \
                cmake -G "Unix Makefiles" -DCMAKE_BUILD_TYPE=Release -DCMAKE_TOOLCHAIN_FILE=${COMMON_DIR}/cmake-cross.cmake \
                      -DCMAKE_INSTALL_LIBDIR=/usr/lib64 -DLIB_SUFFIX=64 -DCMAKE_INSTALL_LIBEXECDIR=/usr/libexec \
                      -DCMAKE_INSTALL_PREFIX=/usr \
                      -DBUILD_SHARED_LIBS=ON \
                      -DSHIBOKEN_BUILD_TOOLS=ON -DBUILD_TESTS=OFF -DQFP_SHIBOKEN_HOST_PATH=${CROSSTOOLS_DIR} -DQFP_PYTHON_HOST_PATH=${HOST_TOOLS_DIR}/bin/python3 -Wno-dev ..
                eval ${MAKE_AND_INSTALL}
        popd
	popd
        rm -f ${SYSROOT_DIR}/usr/lib64/*.la
popd 
rm -rf ${BUILD_DIRECTORY}/pyside-setup-everywhere-src-6.11.0
