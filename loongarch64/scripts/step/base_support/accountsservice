source env/base_support/config
source env/distro.info
source env/function.sh
export STEP_BUILDNAME=base_support
export STEP_PACKAGENAME=accountsservice
export PACKAGE_VERSION=26.27.3
export RESOURCEDIR=${NEW_TARGET_SYSDIR}/files/base_support/accountsservice/26.27.3/
rm -rf ${BUILD_DIRECTORY}/accountsservice-26.27.3
tar xvf ${DOWNLOADDIR}/accountsservice-26.27.3.tar.gz -C ${BUILD_DIRECTORY} 
pushd ${BUILD_DIRECTORY}/accountsservice-26.27.3
	
	mkdir cross-build
	pushd cross-build
		CFLAGS="${CFLAGS} -Wno-implicit-function-declaration" meson ${MESON_CONFIG} -Dsystemdsystemunitdir=/usr/lib/systemd/system \
                      ..
		sed -i "s@gi-docgen \(index\|generate\|gen-index\|gen-deps\|search\|check\|serve\) @& --add-include-path ${SYSROOT_DIR}/usr/share/gir-1.0/ @g" build.ninja
		eval ${NINJA_AND_INSTALL}
	popd
	rm -f ${SYSROOT_DIR}/usr/lib${LIB_SUFF}*.la
popd 
rm -rf ${BUILD_DIRECTORY}/accountsservice-26.27.3
