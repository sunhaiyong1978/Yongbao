source env/base_support/config
source env/distro.info
source env/function.sh
export STEP_BUILDNAME=base_support
export STEP_PACKAGENAME=alsa-lib
export PACKAGE_VERSION=1.2.15.3
export RESOURCEDIR=${NEW_TARGET_SYSDIR}/files/base_support/alsa-lib/1.2.15.3/
rm -rf ${BUILD_DIRECTORY}/alsa-lib-1.2.15.3
tar xvf ${DOWNLOADDIR}/alsa-lib-1.2.15.3.tar.bz2 -C ${BUILD_DIRECTORY} 
pushd ${BUILD_DIRECTORY}/alsa-lib-1.2.15.3
	
	for config_i in $(find -name "config.sub")
	do
		cp -a -f $(automake --print-libdir)/config.{sub,guess} $(dirname ${config_i})/
	done
	if [ ! -f configure ]; then
		autoreconf -ifv
	fi
	 ./configure ${COMMON_CONFIG}  --enable-malloc0returnsnull
	eval ${MAKE_AND_INSTALL}
popd 
rm -rf ${BUILD_DIRECTORY}/alsa-lib-1.2.15.3
