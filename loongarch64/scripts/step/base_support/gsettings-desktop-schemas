source env/base_support/config
source env/distro.info
source env/function.sh
export STEP_BUILDNAME=base_support
export STEP_PACKAGENAME=gsettings-desktop-schemas
export PACKAGE_VERSION=50.1
export RESOURCEDIR=${NEW_TARGET_SYSDIR}/files/base_support/gsettings-desktop-schemas/50.1/
rm -rf ${BUILD_DIRECTORY}/gsettings-desktop-schemas-50.1
tar xvf ${DOWNLOADDIR}/gsettings-desktop-schemas-50.1.tar.xz -C ${BUILD_DIRECTORY} 
pushd ${BUILD_DIRECTORY}/gsettings-desktop-schemas-50.1
	patch -Np1 -i ${SYSDIR}/files/base_support/gsettings-desktop-schemas/50.1/patches/0001-gsettings-desktop-schemas-fix-pc-file-for-cross-buil.patch 
	 
	mkdir cross-build
	pushd cross-build
		 meson ${MESON_CONFIG}  \
                      ..
		sed -i "s@gi-docgen \(index\|generate\|gen-index\|gen-deps\|search\|check\|serve\) @& --add-include-path ${SYSROOT_DIR}/usr/share/gir-1.0/ @g" build.ninja
		eval ${NINJA_AND_INSTALL}
	popd
	rm -f ${SYSROOT_DIR}/usr/lib${LIB_SUFF}*.la
popd 
rm -rf ${BUILD_DIRECTORY}/gsettings-desktop-schemas-50.1
