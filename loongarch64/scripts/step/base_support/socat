source env/base_support/config
source env/distro.info
source env/function.sh
export STEP_BUILDNAME=base_support
export STEP_PACKAGENAME=socat
export PACKAGE_VERSION=1.8.1.0
export RESOURCEDIR=${NEW_TARGET_SYSDIR}/files/base_support/socat/1.8.1.0/
rm -rf ${BUILD_DIRECTORY}/socat-1.8.1.0
tar xvf ${DOWNLOADDIR}/socat-1.8.1.0.tar.gz -C ${BUILD_DIRECTORY} 
pushd ${BUILD_DIRECTORY}/socat-1.8.1.0
	patch -Np1 -i ${SYSDIR}/files/base_support/socat/1.8.1.0/patches/0001-socat-1.8.1.0-fix-build-error-for-glibc-2.43.patch 
	 
	for config_i in $(find -name "config.sub")
	do
		cp -a -f $(automake --print-libdir)/config.{sub,guess} $(dirname ${config_i})/
	done
	if [ ! -f configure ]; then
		autoreconf -ifv
	fi
	 ./configure ${COMMON_CONFIG}  --enable-malloc0returnsnull
	CC="${CROSS_TARGET}-gcc" CXX="${CROSS_TARGET}-g++" make -j${JOBS}
	run_step_package_check check
        make DESTDIR=${SYSROOT_DIR} install
	rm -f ${SYSROOT_DIR}/usr/lib${LIB_SUFF}/*.la
popd 
rm -rf ${BUILD_DIRECTORY}/socat-1.8.1.0
