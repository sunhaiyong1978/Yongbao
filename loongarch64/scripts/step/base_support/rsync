source env/base_support/config
source env/distro.info
source env/function.sh
export STEP_BUILDNAME=base_support
export STEP_PACKAGENAME=rsync
export PACKAGE_VERSION=3.4.3
export RESOURCEDIR=${NEW_TARGET_SYSDIR}/files/base_support/rsync/3.4.3/
rm -rf ${BUILD_DIRECTORY}/rsync-3.4.3
tar xvf ${DOWNLOADDIR}/rsync-3.4.3.tar.gz -C ${BUILD_DIRECTORY} 
pushd ${BUILD_DIRECTORY}/rsync-3.4.3
	
	for config_i in $(find -name "config.sub")
	do
		cp -a -f $(automake --print-libdir)/config.{sub,guess} $(dirname ${config_i})/
	done
	if [ ! -f configure ]; then
		autoreconf -ifv
	fi
	 ./configure ${COMMON_CONFIG}  --disable-simd --enable-malloc0returnsnull
	eval ${MAKE_AND_INSTALL}
popd 
rm -rf ${BUILD_DIRECTORY}/rsync-3.4.3
