source env/base_support/config
source env/distro.info
source env/function.sh
export STEP_BUILDNAME=base_support
export STEP_PACKAGENAME=xmessage
export PACKAGE_VERSION=1.0.7
export RESOURCEDIR=${NEW_TARGET_SYSDIR}/files/base_support/xmessage/1.0.7/
rm -rf ${BUILD_DIRECTORY}/xmessage-1.0.7
tar xvf ${DOWNLOADDIR}/xmessage-1.0.7.tar.xz -C ${BUILD_DIRECTORY} 
pushd ${BUILD_DIRECTORY}/xmessage-1.0.7
	
	for config_i in $(find -name "config.sub")
	do
		cp -a -f $(automake --print-libdir)/config.{sub,guess} $(dirname ${config_i})/
	done
	if [ ! -f configure ]; then
		autoreconf -ifv
	fi
	 ./configure ${COMMON_CONFIG} --with-appdefaultdir=/usr/share/X11/app-defaults --enable-malloc0returnsnull
	eval ${MAKE_AND_INSTALL}
popd 
rm -rf ${BUILD_DIRECTORY}/xmessage-1.0.7
