source env/base_support/config
source env/distro.info
source env/function.sh
export STEP_BUILDNAME=base_support
export STEP_PACKAGENAME=cyrus-sasl
export PACKAGE_VERSION=2.1.28
export RESOURCEDIR=${NEW_TARGET_SYSDIR}/files/base_support/cyrus-sasl/2.1.28/
rm -rf ${BUILD_DIRECTORY}/cyrus-sasl-2.1.28
tar xvf ${DOWNLOADDIR}/cyrus-sasl-2.1.28.tar.gz -C ${BUILD_DIRECTORY} 
pushd ${BUILD_DIRECTORY}/cyrus-sasl-2.1.28
	
	for config_i in $(find -name "config.sub")
	do
		cp -a -f $(automake --print-libdir)/config.{sub,guess} $(dirname ${config_i})/
	done
	if [ ! -f configure ]; then
		autoreconf -ifv
	fi
	CFLAGS="${CFLAGS} -Wno-implicit-function-declaration -std=gnu17" ./configure ${COMMON_CONFIG} --enable-auth-sasldb --with-sphinx-build=no --with-dbpath=/var/lib/sasl/sasldb2 --with-saslauthd=/var/run/saslauthd ac_cv_gssapi_supports_spnego=yes --enable-malloc0returnsnull
	eval ${MAKE_AND_INSTALL}
popd 
rm -rf ${BUILD_DIRECTORY}/cyrus-sasl-2.1.28
