source env/base_support/config
source env/distro.info
source env/function.sh
export STEP_BUILDNAME=base_support
export STEP_PACKAGENAME=libXvMC
export PACKAGE_VERSION=1.0.15
export RESOURCEDIR=${NEW_TARGET_SYSDIR}/files/base_support/libXvMC/1.0.15/
rm -rf ${BUILD_DIRECTORY}/libXvMC-1.0.15
tar xvf ${DOWNLOADDIR}/libXvMC-1.0.15.tar.xz -C ${BUILD_DIRECTORY} 
pushd ${BUILD_DIRECTORY}/libXvMC-1.0.15
	
	for config_i in $(find -name "config.sub")
	do
		cp -a -f $(automake --print-libdir)/config.{sub,guess} $(dirname ${config_i})/
	done
	if [ ! -f configure ]; then
		autoreconf -ifv
	fi
	 ./configure ${COMMON_CONFIG}  --enable-malloc0returnsnull
	eval ${MAKE_AND_INSTALL}
popd 
rm -rf ${BUILD_DIRECTORY}/libXvMC-1.0.15
