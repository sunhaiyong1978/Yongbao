source env/base_support/config
source env/distro.info
source env/function.sh
export STEP_BUILDNAME=base_support
export STEP_PACKAGENAME=libqmi
export PACKAGE_VERSION=1.38.0
export RESOURCEDIR=${NEW_TARGET_SYSDIR}/files/base_support/libqmi/1.38.0/
rm -rf ${BUILD_DIRECTORY}/libqmi-1.38.0
tar xvf ${DOWNLOADDIR}/libqmi-1.38.0.tar.gz -C ${BUILD_DIRECTORY} 
pushd ${BUILD_DIRECTORY}/libqmi-1.38.0
	
	mkdir cross-build
	pushd cross-build
		meson ${MESON_CONFIG}  \
			..
		sed -i "s@gi-docgen \(index\|generate\|gen-index\|gen-deps\|search\|check\|serve\) @& --add-include-path ${SYSROOT_DIR}/usr/share/gir-1.0/ @g" build.ninja
		ninja
		run_step_package_check ninja
		DESTDIR=${PWD}/dest ninja install
		cp -a ${PWD}/dest/* ${SYSROOT_DIR}/
	popd
	rm -f ${SYSROOT_DIR}/usr/lib${LIB_SUFF}*.la
popd 
rm -rf ${BUILD_DIRECTORY}/libqmi-1.38.0
