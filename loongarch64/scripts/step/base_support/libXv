source env/base_support/config
source env/distro.info
source env/function.sh
export STEP_BUILDNAME=base_support
export STEP_PACKAGENAME=libXv
export PACKAGE_VERSION=1.0.13
export RESOURCEDIR=${NEW_TARGET_SYSDIR}/files/base_support/libXv/1.0.13/
rm -rf ${BUILD_DIRECTORY}/libXv-1.0.13
tar xvf ${DOWNLOADDIR}/libXv-1.0.13.tar.xz -C ${BUILD_DIRECTORY} 
pushd ${BUILD_DIRECTORY}/libXv-1.0.13
	
	for config_i in $(find -name "config.sub")
	do
		cp -a -f $(automake --print-libdir)/config.{sub,guess} $(dirname ${config_i})/
	done
	if [ ! -f configure ]; then
		autoreconf -ifv
	fi
	 ./configure ${COMMON_CONFIG}  --enable-malloc0returnsnull
	eval ${MAKE_AND_INSTALL}
popd 
rm -rf ${BUILD_DIRECTORY}/libXv-1.0.13
