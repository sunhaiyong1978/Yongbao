source env/base_support/config
source env/distro.info
source env/function.sh
export STEP_BUILDNAME=base_support
export STEP_PACKAGENAME=xsetroot
export PACKAGE_VERSION=1.1.4
export RESOURCEDIR=${NEW_TARGET_SYSDIR}/files/base_support/xsetroot/1.1.4/
rm -rf ${BUILD_DIRECTORY}/xsetroot-1.1.4
tar xvf ${DOWNLOADDIR}/xsetroot-1.1.4.tar.xz -C ${BUILD_DIRECTORY} 
pushd ${BUILD_DIRECTORY}/xsetroot-1.1.4
	
	for config_i in $(find -name "config.sub")
	do
		cp -a -f $(automake --print-libdir)/config.{sub,guess} $(dirname ${config_i})/
	done
	if [ ! -f configure ]; then
		autoreconf -ifv
	fi
	 ./configure ${COMMON_CONFIG}  --enable-malloc0returnsnull
	eval ${MAKE_AND_INSTALL}
popd 
rm -rf ${BUILD_DIRECTORY}/xsetroot-1.1.4
