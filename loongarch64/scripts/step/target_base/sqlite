source env/target_base/config
source env/distro.info
source env/function.sh
export STEP_BUILDNAME=target_base
export STEP_PACKAGENAME=sqlite
export PACKAGE_VERSION=3.53.4
export RESOURCEDIR=${NEW_TARGET_SYSDIR}/files/target_base/sqlite/3.53.4/
rm -rf ${BUILD_DIRECTORY}/sqlite-version-3.53.4
tar xvf ${DOWNLOADDIR}/sqlite-3.53.4.tar.gz -C ${BUILD_DIRECTORY} 
pushd ${BUILD_DIRECTORY}/sqlite-version-3.53.4
        
        for config_i in $(find -name "config.sub")
        do
                chmod 0644 $(dirname ${config_i})/config.{sub,guess}
                cp -a -f $(automake --print-libdir)/config.{sub,guess} $(dirname ${config_i})/
        done
        if [ ! -f configure ]; then
                autoreconf -ifv
        fi

	sed -i "/^LDFLAGS.rpath/s,@LDFLAGS_RPATH@,,g" Makefile.in autoconf/Makefile.in

        ./configure --prefix=/usr --sysconfdir=/etc --localstatedir=/var --libdir=/usr/lib${LIB_SUFF} \
		--build=${CROSS_HOST} --host=${CROSS_TARGET} \
		--enable-fts5  CPPFLAGS="-DSQLITE_ENABLE_FTS3=1  -DSQLITE_ENABLE_FTS4=1  -DSQLITE_ENABLE_COLUMN_METADATA=1  -DSQLITE_ENABLE_UNLOCK_NOTIFY=1  -DSQLITE_ENABLE_DBSTAT_VTAB=1  -DSQLITE_SECURE_DELETE=1 -DSQLITE_ENABLE_FTS3_TOKENIZER=1" --soname=legacy --with-tcl=${SYSROOT_DIR}/usr/lib${LIB_SUFF} --with-tclsh=${CROSSTOOLS_DIR}/bin/${CROSS_TARGET}-tclsh
	sed -i "/TCLLIBDIR/s@${SYSROOT_DIR}@@g" Makefile
	check_gnu_Makefile
        CC="${CROSS_TARGET}-gcc" CXX="${CROSS_TARGET}-g++" make -j${JOBS}
        run_step_package_check check
        make DESTDIR=${SYSROOT_DIR} install
        rm -f ${SYSROOT_DIR}/usr/lib${LIB_SUFF}/*.la
popd 
rm -rf ${BUILD_DIRECTORY}/sqlite-version-3.53.4
