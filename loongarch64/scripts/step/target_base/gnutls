source env/target_base/config
source env/distro.info
source env/function.sh
export STEP_BUILDNAME=target_base
export STEP_PACKAGENAME=gnutls
export PACKAGE_VERSION=3.8.13
export RESOURCEDIR=${NEW_TARGET_SYSDIR}/files/target_base/gnutls/3.8.13/
rm -rf ${BUILD_DIRECTORY}/gnutls-3.8.13
tar xvf ${DOWNLOADDIR}/gnutls-3.8.13.tar.xz -C ${BUILD_DIRECTORY} 
pushd ${BUILD_DIRECTORY}/gnutls-3.8.13
	patch -Np1 -i ${SYSDIR}/files/target_base/gnutls/3.8.13/patches/0001-gnutls-3.8.12-remove-L-libdir-at-gnutls.pc-for-cross.patch 
	 
	for config_i in $(find -name "config.sub")
	do
		chmod 0644 $(dirname ${config_i})/config.{sub,guess}
		cp -a -f $(automake --print-libdir)/config.{sub,guess} $(dirname ${config_i})/
	done
	if [ ! -f configure ]; then
		autoreconf -ifv
	fi
	 ./configure ${COMMON_CONFIG} --enable-openssl-compatibility --enable-ssl3-support --with-default-trust-store-pkcs11="pkcs11:" --with-libz-prefix=${SYSROOT_DIR}/usr --disable-guile --disable-doc --enable-static --without-libcrypto-prefix --enable-malloc0returnsnull
	eval ${MAKE_AND_INSTALL}
popd 
rm -rf ${BUILD_DIRECTORY}/gnutls-3.8.13
