source env/target_base/config
source env/distro.info
source env/function.sh
export STEP_BUILDNAME=target_base
export STEP_PACKAGENAME=m4
export PACKAGE_VERSION=1.4.21
export RESOURCEDIR=${NEW_TARGET_SYSDIR}/files/target_base/m4/1.4.21/
rm -rf ${BUILD_DIRECTORY}/m4-1.4.21
tar xvf ${DOWNLOADDIR}/m4-1.4.21.tar.xz -C ${BUILD_DIRECTORY} 
pushd ${BUILD_DIRECTORY}/m4-1.4.21
	
	for config_i in $(find -name "config.sub")
	do
		chmod 0644 $(dirname ${config_i})/config.{sub,guess}
		cp -a -f $(automake --print-libdir)/config.{sub,guess} $(dirname ${config_i})/
	done
	if [ ! -f configure ]; then
		autoreconf -ifv
	fi
	 ./configure ${COMMON_CONFIG} AUTOMAKE=automake ACLOCAL=aclocal --enable-malloc0returnsnull
	eval ${MAKE_AND_INSTALL}
popd 
rm -rf ${BUILD_DIRECTORY}/m4-1.4.21
