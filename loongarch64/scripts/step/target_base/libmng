source env/target_base/config
source env/distro.info
source env/function.sh
export STEP_BUILDNAME=target_base
export STEP_PACKAGENAME=libmng
export PACKAGE_VERSION=2.0.3
export RESOURCEDIR=${NEW_TARGET_SYSDIR}/files/target_base/libmng/2.0.3/
rm -rf ${BUILD_DIRECTORY}/libmng-2.0.3
tar xvf ${DOWNLOADDIR}/libmng-2.0.3.tar.xz -C ${BUILD_DIRECTORY} 
pushd ${BUILD_DIRECTORY}/libmng-2.0.3
	patch -Np1 -i ${SYSDIR}/files/target_base/libmng/2.0.3/patches/0001-remove-absolute-directory-to-linker.patch 
	 
	for config_i in $(find -name "config.sub")
	do
		chmod 0644 $(dirname ${config_i})/config.{sub,guess}
		cp -a -f $(automake --print-libdir)/config.{sub,guess} $(dirname ${config_i})/
	done
	if [ ! -f configure ]; then
		autoreconf -ifv
	fi
	 ./configure ${COMMON_CONFIG}  --enable-malloc0returnsnull
	eval ${MAKE_AND_INSTALL}
popd 
rm -rf ${BUILD_DIRECTORY}/libmng-2.0.3
