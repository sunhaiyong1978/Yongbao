source env/target_base/config
source env/distro.info
source env/function.sh
export STEP_BUILDNAME=target_base
export STEP_PACKAGENAME=libidn2
export PACKAGE_VERSION=2.3.8
export RESOURCEDIR=${NEW_TARGET_SYSDIR}/files/target_base/libidn2/2.3.8/
rm -rf ${BUILD_DIRECTORY}/libidn2-2.3.8
tar xvf ${DOWNLOADDIR}/libidn2-2.3.8.tar.gz -C ${BUILD_DIRECTORY} 
pushd ${BUILD_DIRECTORY}/libidn2-2.3.8
	
	for config_i in $(find -name "config.sub")
	do
		chmod 0644 $(dirname ${config_i})/config.{sub,guess}
		cp -a -f $(automake --print-libdir)/config.{sub,guess} $(dirname ${config_i})/
	done
	if [ ! -f configure ]; then
		autoreconf -ifv
	fi
	 ./configure ${COMMON_CONFIG} --without-libunistring-prefix --enable-malloc0returnsnull
	eval ${MAKE_AND_INSTALL}
popd 
rm -rf ${BUILD_DIRECTORY}/libidn2-2.3.8
