source env/target_base/config
source env/distro.info
source env/function.sh
export STEP_BUILDNAME=target_base
export STEP_PACKAGENAME=fontconfig
export PACKAGE_VERSION=2.18.2
export RESOURCEDIR=${NEW_TARGET_SYSDIR}/files/target_base/fontconfig/2.18.2/
rm -rf ${BUILD_DIRECTORY}/fontconfig-2.18.2
tar xvf ${DOWNLOADDIR}/fontconfig-2.18.2.tar.gz -C ${BUILD_DIRECTORY} 
pushd ${BUILD_DIRECTORY}/fontconfig-2.18.2
	
	mkdir cross-build
	pushd cross-build
		meson ${MESON_CONFIG} \
			..
		ninja fcalias.h
		eval ${NINJA_AND_INSTALL}
	popd
	rm -f ${SYSROOT_DIR}/usr/lib${LIB_SUFF}/*.la
popd 
rm -rf ${BUILD_DIRECTORY}/fontconfig-2.18.2
