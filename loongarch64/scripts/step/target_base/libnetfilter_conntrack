source env/target_base/config
source env/distro.info
source env/function.sh
export STEP_BUILDNAME=target_base
export STEP_PACKAGENAME=libnetfilter_conntrack
export PACKAGE_VERSION=1.1.1
export RESOURCEDIR=${NEW_TARGET_SYSDIR}/files/target_base/libnetfilter_conntrack/1.1.1/
rm -rf ${BUILD_DIRECTORY}/libnetfilter_conntrack-1.1.1
tar xvf ${DOWNLOADDIR}/libnetfilter_conntrack-1.1.1.tar.xz -C ${BUILD_DIRECTORY} 
pushd ${BUILD_DIRECTORY}/libnetfilter_conntrack-1.1.1
	
	for config_i in $(find -name "config.sub")
	do
		chmod 0644 $(dirname ${config_i})/config.{sub,guess}
		cp -a -f $(automake --print-libdir)/config.{sub,guess} $(dirname ${config_i})/
	done
	if [ ! -f configure ]; then
		autoreconf -ifv
	fi
	 ./configure ${COMMON_CONFIG}  --enable-malloc0returnsnull
	eval ${MAKE_AND_INSTALL}
popd 
rm -rf ${BUILD_DIRECTORY}/libnetfilter_conntrack-1.1.1
