source env/linux_runtime/config
source env/distro.info
source env/function.sh
source env/linux_runtime/custom
export STEP_BUILDNAME=linux_runtime
export STEP_PACKAGENAME=x265
export PACKAGE_VERSION=4.3
export RESOURCEDIR=${NEW_TARGET_SYSDIR}/files/linux_runtime/x265/4.3/
rm -rf ${BUILD_DIRECTORY}/x265-4.3
tar xvf ${DOWNLOADDIR}/x265-4.3.tar.gz -C ${BUILD_DIRECTORY} 
pushd ${BUILD_DIRECTORY}/x265-4.3
    
    mkdir cross-build
    pushd cross-build
        CC="${LINUX_HOST}-gcc" CXX="${LINUX_HOST}-g++" \
        cmake -G "Unix Makefiles" -DCMAKE_BUILD_TYPE=Release \
              -DCMAKE_INSTALL_PREFIX=/usr -DLIB_INSTALL_DIR=/usr/lib${LIB_SUFF} -DENABLE_ASSEMBLY=OFF \
	      -DCMAKE_POLICY_VERSION_MINIMUM=3.5 \
              -DGIT_ARCHETYPE=1 \
	      -Wno-dev ../source
	eval ${MAKE_AND_INSTALL}
    popd
popd 
rm -rf ${BUILD_DIRECTORY}/x265-4.3
