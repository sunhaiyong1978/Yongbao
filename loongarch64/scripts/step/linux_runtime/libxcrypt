source env/linux_runtime/config
source env/distro.info
source env/function.sh
source env/linux_runtime/custom
export STEP_BUILDNAME=linux_runtime
export STEP_PACKAGENAME=libxcrypt
export PACKAGE_VERSION=4.5.2
export RESOURCEDIR=${NEW_TARGET_SYSDIR}/files/linux_runtime/libxcrypt/4.5.2/
rm -rf ${BUILD_DIRECTORY}/libxcrypt-4.5.2
tar xvf ${DOWNLOADDIR}/libxcrypt-4.5.2.tar.xz -C ${BUILD_DIRECTORY} 
pushd ${BUILD_DIRECTORY}/libxcrypt-4.5.2
	patch -Np1 -i ${SYSDIR}/files/linux_runtime/libxcrypt/4.5.2/patches/0001-fix-configure-error-under-loongarch64-architecture.patch 
	patch -Np1 -i ${SYSDIR}/files/linux_runtime/libxcrypt/4.5.2/patches/0001-libxcrypt-4.5.2-fix-build-error-for-glibc-2.43.patch 
	 
	if [ ! -f configure ]; then
		autoreconf -ifv
	fi
	CFLAGS="${BASE_CFLAGS} -Wno-error=stringop-overread" ./configure ${COMMON_CONFIG}  --enable-malloc0returnsnull
	eval ${MAKE_AND_INSTALL}
popd 
rm -rf ${BUILD_DIRECTORY}/libxcrypt-4.5.2
