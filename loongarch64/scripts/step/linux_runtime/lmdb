source env/linux_runtime/config
source env/distro.info
source env/function.sh
source env/linux_runtime/custom
export STEP_BUILDNAME=linux_runtime
export STEP_PACKAGENAME=lmdb
export PACKAGE_VERSION=LMDB_1.0.0-branch
export RESOURCEDIR=${NEW_TARGET_SYSDIR}/files/linux_runtime/lmdb/LMDB_1.0.0-branch/
rm -rf ${BUILD_DIRECTORY}/lmdb-LMDB_1.0.0-branch
tar xvf ${DOWNLOADDIR}/lmdb-LMDB_1.0.0-branch.tar.gz -C ${BUILD_DIRECTORY} 
pushd ${BUILD_DIRECTORY}/lmdb-LMDB_1.0.0-branch
    pushd libraries/liblmdb
        make -j${JOBS} CC=${LINUX_HOST}-gcc prefix=/usr libdir=/usr/lib${LIB_SUFF}
        make DESTDIR=${LINUX_SYSROOT_DIR} prefix=/usr libdir=/usr/lib${LIB_SUFF} install
    popd
popd 
rm -rf ${BUILD_DIRECTORY}/lmdb-LMDB_1.0.0-branch
