source env/linux_runtime/config
source env/distro.info
source env/function.sh
source env/linux_runtime/custom
export STEP_BUILDNAME=linux_runtime
export STEP_PACKAGENAME=pipewire
export PACKAGE_VERSION=1.6.8
export RESOURCEDIR=${NEW_TARGET_SYSDIR}/files/linux_runtime/pipewire/1.6.8/
rm -rf ${BUILD_DIRECTORY}/pipewire-1.6.8
tar xvf ${DOWNLOADDIR}/pipewire-1.6.8.tar.gz -C ${BUILD_DIRECTORY} 
pushd ${BUILD_DIRECTORY}/pipewire-1.6.8
	patch -Np1 -i ${SYSDIR}/files/linux_runtime/pipewire/1.6.8/patches/0001-pipewire-1.6.2-fix-for-glibc-2.43.patch 
	 
	mkdir cross-build
	pushd cross-build
		 meson ${MESON_CONFIG} --default-library=both -Dsession-managers="[]" -Dffmpeg=enabled -Dsystemd-user-unit-dir=/usr/lib/systemd/user \
                      ..
		eval ${NINJA_AND_INSTALL}
	popd
	rm -f ${LINUX_SYSROOT_DIR}/usr/lib${LIB_SUFF}/*.la
popd 
rm -rf ${BUILD_DIRECTORY}/pipewire-1.6.8
