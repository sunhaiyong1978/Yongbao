source env/linux_runtime/config
source env/distro.info
source env/function.sh
source env/linux_runtime/custom
export STEP_BUILDNAME=linux_runtime
export STEP_PACKAGENAME=krb5
export PACKAGE_VERSION=1.22.2
export RESOURCEDIR=${NEW_TARGET_SYSDIR}/files/linux_runtime/krb5/1.22.2/
rm -rf ${BUILD_DIRECTORY}/krb5-1.22.2
tar xvf ${DOWNLOADDIR}/krb5-1.22.2.tar.gz -C ${BUILD_DIRECTORY} 
pushd ${BUILD_DIRECTORY}/krb5-1.22.2
    patch -Np1 -i ${SYSDIR}/files/linux_runtime/krb5/1.22.2/patches/0001-krb5-1.22.1-fix-build-error-for-glibc-2.43.patch 
	 
    pushd src
	CFLAGS="${CFLAGS} -std=gnu17" \
        ./configure ${COMMON_CONFIG} --runstatedir=/run \
                    --with-system-ss --with-system-verto=no \
                    --enable-dns-for-realm \
                    krb5_cv_attr_constructor_destructor=yes,yes \
                    ac_cv_func_regcomp=yes ac_cv_printf_positional=yes
        eval ${MAKE_AND_INSTALL}
    popd
popd 
rm -rf ${BUILD_DIRECTORY}/krb5-1.22.2
cp -v ${LINUX_SYSROOT_DIR}/usr/bin/krb5-config ${CROSS_TOOLS_PREFIX}/bin/
sed -i "s@-L\$libdir@@g" ${CROSS_TOOLS_PREFIX}/bin/krb5-config
