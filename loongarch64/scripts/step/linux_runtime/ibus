source env/linux_runtime/config
source env/distro.info
source env/function.sh
source env/linux_runtime/custom
export STEP_BUILDNAME=linux_runtime
export STEP_PACKAGENAME=ibus
export PACKAGE_VERSION=1.5.34
export RESOURCEDIR=${NEW_TARGET_SYSDIR}/files/linux_runtime/ibus/1.5.34/
rm -rf ${BUILD_DIRECTORY}/ibus-1.5.34
tar xvf ${DOWNLOADDIR}/ibus-1.5.34.tar.gz -C ${BUILD_DIRECTORY} 
pushd ${BUILD_DIRECTORY}/ibus-1.5.34
    
    autoreconf -ifv
    for config_i in $(find -name "config.sub")
    do
            cp -a -f $(automake --print-libdir)/config.{sub,guess} $(dirname ${config_i})/
    done

   sed -i "s@\$(builddir)/gen-internal-compose-table@qemu-${QEMU_ARCH} \$(builddir)/gen-internal-compose-table@g" src/Makefile.in
   sed -i "s@\$(builddir)/unicode-parser@qemu-${QEMU_ARCH} \$(builddir)/unicode-parser@g" src/Makefile.in
   sed -i "s@\$(builddir)/emoji-parser@qemu-${QEMU_ARCH} \$(builddir)/emoji-parser@g" src/Makefile.in

    export CFLAGS="${CFLAGS} -Wno-incompatible-pointer-types"
    mkdir cross-build
    pushd cross-build
        ../configure ${COMMON_CONFIG} \
                     --disable-emoji-dict --disable-unicode-dict --enable-introspection=no --disable-python2 --disable-ui \
		     --disable-gtk4 --disable-dconf --disable-appindicator --disable-libnotify --disable-wayland --enable-introspection=no --enable-vala=no --disable-engine
	check_gnu_Makefile
	make -j${JOBS} CC_FOR_BUILD=${LINUX_HOST}-gcc GLIB_COMPILE_RESOURCES=${CROSS_TOOLS_PREFIX}/bin/${LINUX_HOST}-glib-compile-resources -C src
        make -C src DESTDIR=${LINUX_SYSROOT_DIR} install
    popd

    rm -v ${LINUX_SYSROOT_DIR}/usr/lib${LIB_SUFF}/libibus*.la
popd 
rm -rf ${BUILD_DIRECTORY}/ibus-1.5.34
