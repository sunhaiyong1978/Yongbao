source env/cross-tools/config
source env/distro.info
source env/function.sh
source env/cross-tools/custom
export STEP_BUILDNAME=cross-tools
export STEP_PACKAGENAME=pkgconf
export PACKAGE_VERSION=3.0.5
export RESOURCEDIR=${NEW_TARGET_SYSDIR}/files/cross-tools/pkgconf/3.0.5/
if [ ! -f ${HOST_TOOLS_DIR}/bin/pkgconf ]; then
rm -rf ${BUILD_DIRECTORY}/pkgconf-3.0.5
tar xvf ${DOWNLOADDIR}/pkgconf-3.0.5.tar.xz -C ${BUILD_DIRECTORY} 
pushd ${BUILD_DIRECTORY}/pkgconf-3.0.5
        
        for config_i in $(find -name "config.sub")
        do
                cp -a -f $(automake --print-libdir)/config.{sub,guess} $(dirname ${config_i})/
        done
        if [ ! -f configure ]; then
                autoreconf -ifv
        fi
        ./configure --prefix=${HOST_TOOLS_DIR} --build=${CROSS_HOST} \
                --host=${CROSS_HOST} --target=${CROSS_TARGET}
        eval ${MAKE_AND_INSTALL}
popd 
rm -rf ${BUILD_DIRECTORY}/pkgconf-3.0.5
fi

mkdir -p ${CROSSTOOLS_DIR}/bin

rm -f ${CROSSTOOLS_DIR}/bin/${CROSS_TARGET}-pkg-config

cat > ${CROSSTOOLS_DIR}/bin/${CROSS_TARGET}-pkg-config << EOF
#!/bin/bash -e

if echo "\$@" | grep -q "\--variable=" && \\
 ! echo "\$@" | grep -q "variable=datadir vapigen" && \\
 ! echo "\$@" | grep -q "variable=bindir Qt6Core" && \\
 ! echo "\$@" | grep -q "variable=libexecdir Qt6Core" && \\
 ! echo "\$@" | grep -q "variable=interfaces_dir flatpak" && \\
 ! echo "\$@" | grep -q "variable=datadir gobject-introspection" && \\
 ! echo "\$@" | grep -q "variable=pkgdatadir wayland" && \\
 ! echo "\$@" | grep -q "variable=xcbincludedir xcb-proto" && \\
 ! echo "\$@" | grep -q "variable=pythondir xcb-proto" && \\
 ! echo "\$@" | grep -q "variable=libdir " && \\
 ! echo "\$@" | grep -q "variable=includedir "; then
    unset PKG_CONFIG_SYSROOT_DIR
fi

${HOST_TOOLS_DIR}/bin/pkgconf "\$@"
EOF
chmod +x ${CROSSTOOLS_DIR}/bin/${CROSS_TARGET}-pkg-config
