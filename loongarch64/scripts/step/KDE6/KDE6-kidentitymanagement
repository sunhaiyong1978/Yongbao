source env/KDE6/config
source env/distro.info
source env/function.sh
export STEP_BUILDNAME=KDE6
export STEP_PACKAGENAME=KDE6-kidentitymanagement
export PACKAGE_VERSION=26.04.3
export RESOURCEDIR=${NEW_TARGET_SYSDIR}/files/KDE6/KDE6-kidentitymanagement/26.04.3/
rm -rf ${BUILD_DIRECTORY}/kidentitymanagement-26.04.3
tar xvf ${DOWNLOADDIR}/kidentitymanagement-26.04.3.tar.xz -C ${BUILD_DIRECTORY} 
pushd ${BUILD_DIRECTORY}/kidentitymanagement-26.04.3
        
	mkdir cross-build
	pushd cross-build
        	CC="${CROSS_TARGET}-gcc" CXX="${CROSS_TARGET}-g++"  \
		cmake -G "Unix Makefiles" -DCMAKE_BUILD_TYPE=Release -DCMAKE_TOOLCHAIN_FILE=${COMMON_DIR}/cmake-cross.cmake \
		      -DKI18N_PYTHON_EXECUTABLE=${CROSSTOOLS_DIR}/bin/${CROSS_TARGET}-python3 \
		      -D_Python3_CONFIG=${HOST_TOOLS_DIR}/bin/python3-config \
		      -D_Python_CONFIG=${HOST_TOOLS_DIR}/bin/python3-config \
		      -DCMAKE_INSTALL_LIBDIR=/usr/lib64 -DLIB_SUFFIX=64 -DCMAKE_INSTALL_LIBEXECDIR=/usr/libexec \
       		      -DCMAKE_INSTALL_PREFIX=/usr \
		      -DBUILD_SHARED_LIBS=ON \
		      -DCMAKE_POLICY_VERSION_MINIMUM=3.5 \
		       -Wno-dev ..
		eval ${MAKE_AND_INSTALL}
	popd
        rm -f ${SYSROOT_DIR}/usr/lib64/*.la
popd 
rm -rf ${BUILD_DIRECTORY}/kidentitymanagement-26.04.3
