source env/simulate/config
source env/distro.info
source env/function.sh
export STEP_BUILDNAME=simulate
export STEP_PACKAGENAME=liblasx2lsx
export PACKAGE_VERSION=git
export RESOURCEDIR=${NEW_TARGET_SYSDIR}/files/simulate/liblasx2lsx/git/
rm -rf ${BUILD_DIRECTORY}/liblasx2lsx-git_git
tar xvf ${DOWNLOADDIR}/liblasx2lsx-git_git.tar.gz -C ${BUILD_DIRECTORY} 
